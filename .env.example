# Required (anthropic example: claude-sonnet-5-5)
LLM_MODEL=your-model-identifier-here

# Provider: anthropic (default) | openai | bedrock
# openai and bedrock need an extra: uv sync --extra openai / uv sync --extra bedrock
# LLM_PROVIDER=anthropic

# API key — required for anthropic and openai; omit for bedrock (uses AWS credential chain)
LLM_API_KEY=your-api-key-here

# Bedrock only (both optional — falls back to default AWS credential chain)
# AWS_PROFILE=your-aws-profile
# AWS_REGION=us-east-1

AGENT_VERBOSE=false

# Optional (defaults shown)
HOST=0.0.0.0
PORT=8000
MAX_REQUEST_BODY_SIZE=1048576

# Per-client requests allowed per minute (429 beyond this)
RATE_LIMIT_PER_MINUTE=20
# Require this value in the X-Dopamine-Key header on every request except /health (unset = open)
# DOPAMINE_ACCESS_KEY=
# Max seconds to wait for the agent before returning 504
AGENT_TIMEOUT_SECONDS=30
# Headers whose values are replaced with [REDACTED] before the agent sees them (comma-separated)
SENSITIVE_HEADER_NAMES=authorization,proxy-authorization,cookie,set-cookie,x-api-key
# Any header whose name contains one of these fragments is also redacted
SENSITIVE_HEADER_FRAGMENTS=token,secret,key

# Personality preset from config/personalities/: default | shop | sarcastic | website | teapot
# PERSONALITY=default
# Custom personality file; when set, wins over PERSONALITY
# PERSONALITY_PATH=
# JSON file for the agent's key-value storage (unset = in-memory, empty on every start)
# STATE_FILE=
# Max size of one stored value (compact UTF-8 JSON bytes) and max number of keys
KV_MAX_VALUE_BYTES=65536
KV_MAX_KEYS=1000
# USD per 1M tokens; set both to get the X-Dopamine-Cost-USD header (no defaults shipped)
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
