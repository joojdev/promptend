# Required
LLM_MODEL=your-model-identifier-here

# Provider: anthropic (default) | openai | bedrock
# LLM_PROVIDER=anthropic

# API key — required for anthropic and openai; omit for bedrock (uses AWS credential chain)
LLM_API_KEY=your-api-key-here

# Bedrock only (both optional — falls back to default AWS credential chain)
# AWS_PROFILE=your-aws-profile
# AWS_REGION=us-east-1

AGENT_VERBOSE=false

# Optional (defaults shown)
HOST=0.0.0.0
PORT=8000
MAX_REQUEST_BODY_SIZE=1048576
